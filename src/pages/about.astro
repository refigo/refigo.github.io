---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Mijong Go — robotics engineer building context-aware interaction agents for robots deployed with real customers.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			I'm Mijong Go, a robotics engineer in Seoul. I lead an agentic AI team working on multimodal
			interaction, task-planning agents, and vision for service robots that operate in public
			spaces every day.
		</p>
		<p>
			Robots working among people need social intelligence — reading context and responding in
			ways people understand. I build context-aware interaction agents and prove them on robots
			deployed with real customers.
		</p>
		<p>What I write about here:</p>
		<ul class="list-inside list-disc" role="list">
			<li>
				Human-robot interaction — how robots should read people and respond in ways people
				understand
			</li>
			<li>
				Agents — robotics agents that act in the physical world, and the agentic systems I build to
				run my own work
			</li>
			<li>
				Usable service products — what it takes for a robot or an agent to become something people
				actually use every day
			</li>
			<li>Philosophy — what I enjoy building, and where I'm heading</li>
		</ul>
		<p>Finished pieces go in Blog. Work in progress goes in Notes.</p>
		<p>
			You can find my code on <a
				class="cactus-link inline-block"
				href="https://github.com/refigo"
				rel="noreferrer"
				target="_blank">GitHub</a
			>.
		</p>
	</div>
</PageLayout>
