---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Mijong Go — robotics engineer building context-aware interaction agents for robots deployed with real customers.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-12">About</h1>
	<div class="prose prose-sm prose-cactus max-w-none">
		<p>
			I'm Mijong Go, a robotics engineer in Seoul. I lead an agentic AI team working on voice
			interaction, task-planning agents, and vision for service robots that operate in public
			spaces every day.
		</p>
		<p>
			Robots working among people need social intelligence — reading context and responding in
			ways people understand. I build context-aware interaction agents and prove them on robots
			deployed with real customers.
		</p>
		<p>This blog follows two threads:</p>
		<ul class="list-inside list-disc" role="list">
			<li>
				Building robot agents — LLM task planners, memory, voice pipelines, and what actually
				breaks when robots leave the lab
			</li>
			<li>
				Human-robot interaction — reviews of and perspectives on research about how robots should
				behave around people
			</li>
		</ul>
		<p>
			You can find my code on <a
				class="cactus-link inline-block"
				href="https://github.com/refigo"
				rel="noreferrer"
				target="_blank">GitHub</a
			>.
		</p>
	</div>
</PageLayout>
